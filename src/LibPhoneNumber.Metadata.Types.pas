unit LibPhoneNumber.Metadata.Types;

{
  Data model for the generated libphonenumber metadata tables.

  The layout mirrors the upstream Java protos (Phonemetadata.PhoneMetadata,
  PhoneNumberDesc, NumberFormat) as produced by
  tools/java/common/src/com/google/i18n/phonenumbers/BuildMetadataFromXml.java,
  so the runtime interpreter can follow the Java code path
  literally.

  Variable length data (possible lengths, leadingDigits patterns, number
  formats, descriptions) is not stored inline. It lives in flat pools inside
  LibPhoneNumber.Metadata.Data and is addressed through offset/count
  pairs. That keeps every generated table a plain typed constant which both
  Delphi and FreePascal can digest without run time construction.

  It also carries TPhoneMetadataTables, the record that makes
  a whole phone metadata data set addressable through one value. That is what
  lets LibPhoneNumber.Metadata read an ACTIVE data set instead of naming a
  generated unit, and it is what the upstream TEST metadata is installed
  through; see the header of that unit.

  The unit also carries the SHORT number data model
  (TShortNumberDescKind, TShortMetadataRec), which the generated
  LibPhoneNumber.ShortMetadata.* units and their lookup layer use. The
  description record TPhoneNumberDescRec is shared between the two data
  sets, because BuildMetadataFromXml builds both through the very same
  processPhoneNumberDescElement.

  This unit is hand written. The data units are generated by
  tools/generate_metadata.ps1.
}

{$IFDEF FPC}
{$MODE DELPHI}
{$H+}
{$ENDIF}

interface

type
  { Number description kinds, in the order they are stored per territory.
    pdkGeneralDesc must stay first: it is the parent description all other
    kinds inherit their possible lengths from. }
  TPhoneNumberDescKind = (
    pdkGeneralDesc,
    pdkFixedLine,
    pdkMobile,
    pdkTollFree,
    pdkPremiumRate,
    pdkSharedCost,
    pdkPersonalNumber,
    pdkVoip,
    pdkPager,
    pdkUan,
    pdkVoicemail,
    pdkNoInternationalDialling
  );

const
  PhoneNumberDescKindCount = Ord(pdkNoInternationalDialling) + 1;

type
  { Short number description kinds, in the order they are stored per territory.

    This is the SHORT number desc set of upstream
    BuildMetadataFromXml.setRelevantDescPatterns, i.e. the
    isShortNumberMetadata = true branch, with generalDesc prepended because it
    is the parent every other kind inherits its possible lengths from. The
    remaining seven are listed in the order that branch sets them.

    Deliberately NOT a subset of TPhoneNumberDescKind: the two desc sets only
    look similar. shortCode, carrierSpecific, emergency, standardRate and
    smsServices do not exist in the phone metadata, and fixedLine, mobile,
    sharedCost, personalNumber, voip, pager, uan, voicemail and
    noInternationalDialling do not exist in the short number metadata.

    expandedEmergency IS present in ShortNumberMetadata.xml but is NOT read by
    upstream BuildMetadataFromXml, so it is not part of this set either. }
  TShortNumberDescKind = (
    sdkGeneralDesc,
    sdkStandardRate,
    sdkShortCode,
    sdkCarrierSpecific,
    sdkEmergency,
    sdkTollFree,
    sdkPremiumRate,
    sdkSmsServices
  );

const
  ShortNumberDescKindCount = Ord(sdkSmsServices) + 1;

type
  TMetadataIntegerArray = array of Integer;
  TMetadataStringArray = array of string;

  { One PhoneNumberDesc.

    HasData is False when the XML element was absent. Upstream encodes that
    case as a single possible length of -1 which can never match a real
    number; the generator keeps that encoding so length checks can be ported
    verbatim, and HasData is provided as the readable equivalent.

    LengthCount = 0 means "same possible lengths as the general description"
    (upstream drops redundant length lists for size reasons). Callers must
    fall back to the pdkGeneralDesc entry in that case, exactly like
    PhoneNumberUtil.testNumberLength does. }
  TPhoneNumberDescRec = record
    HasData: Boolean;
    NationalNumberPattern: string;
    ExampleNumber: string;
    LengthOffset: Integer;
    LengthCount: Integer;
    LocalOnlyOffset: Integer;
    LocalOnlyCount: Integer;
  end;
  PPhoneNumberDescRec = ^TPhoneNumberDescRec;

  { How the international format of a numberFormat block was derived.

    ifkInheritedFromNational: no <intlFormat> child, the national format
      applies internationally as well.
    ifkExplicit: an <intlFormat> child with a real format string.
    ifkNotAvailable: <intlFormat>NA</intlFormat>, i.e. the block must not be
      used for international formatting at all.

    Upstream materialises this as a separate intl format list per territory
    (see TPhoneMetadataRec.IntlFormatOffset/IntlFormatCount); the kind is kept
    additionally so the origin of every entry stays visible. }
  TIntlFormatKind = (
    ifkInheritedFromNational,
    ifkExplicit,
    ifkNotAvailable
  );

  { One NumberFormat. IntlFormatKind/IntlFormat describe the <intlFormat>
    child of this very block; the ready made upstream intl list is reachable
    through TPhoneMetadataRec.IntlFormatOffset. }
  TNumberFormatRec = record
    Pattern: string;
    Format: string;
    LeadingDigitsOffset: Integer;
    LeadingDigitsCount: Integer;
    NationalPrefixFormattingRule: string;
    NationalPrefixOptionalWhenFormatting: Boolean;
    DomesticCarrierCodeFormattingRule: string;
    IntlFormatKind: TIntlFormatKind;
    IntlFormat: string;
  end;
  PNumberFormatRec = ^TNumberFormatRec;

  { One territory. Id is the CLDR region code, or '001' for the
    non geographical entities (country codes 800, 808, 870, ...), which are
    looked up by country code instead of by region code.

    LeadingDigits is the territory attribute used to disambiguate shared
    country calling codes. It is unrelated to the leadingDigits patterns of a
    number format. }
  TPhoneMetadataRec = record
    Id: string;
    CountryCode: Integer;
    LeadingDigits: string;
    InternationalPrefix: string;
    PreferredInternationalPrefix: string;
    NationalPrefix: string;
    NationalPrefixForParsing: string;
    NationalPrefixTransformRule: string;
    PreferredExtnPrefix: string;
    MainCountryForCode: Boolean;
    MobileNumberPortableRegion: Boolean;
    SameMobileAndFixedLinePattern: Boolean;
    DescOffset: Integer;
    FormatOffset: Integer;
    FormatCount: Integer;
    IntlFormatOffset: Integer;
    IntlFormatCount: Integer;
  end;
  PPhoneMetadataRec = ^TPhoneMetadataRec;

  { One short number territory.

    Short number metadata carries a single attribute per territory, id, so
    there is nothing else to store: no country calling code, no prefixes and no
    number formats. Lookup is therefore by REGION CODE only, exactly like
    upstream ShortNumberInfo.getShortNumberMetadataForRegion, and there are no
    non geographical entities.

    Descriptions live in the same flat pool style as the phone metadata, and
    the record type of a single description (TPhoneNumberDescRec) is shared,
    because BuildMetadataFromXml builds both through the very same
    processPhoneNumberDescElement. }
  TShortMetadataRec = record
    Id: string;
    DescOffset: Integer;
  end;
  PShortMetadataRec = ^TShortMetadataRec;

  { Country calling code to territory mapping, mirroring
    BuildMetadataFromXml.buildCountryCodeToRegionCodeMap: the territory
    flagged mainCountryForCode comes first, the remaining ones follow in
    upstream document order. }
  TCountryCodeGroupRec = record
    CountryCode: Integer;
    RegionOffset: Integer;
    RegionCount: Integer;
  end;
  PCountryCodeGroupRec = ^TCountryCodeGroupRec;

  { One country calling code of the ALTERNATE FORMATS data set.

    Deliberately not TCountryCodeGroupRec: that one addresses TERRITORY
    indices, this one addresses a slice of AlternateFormatsNumberFormats. The
    alternate formats input carries no territory id at all - upstream
    buildCountryCodeToRegionCodeMap has an explicit "for alternate formats,
    there are no region codes" branch - so the calling code is the whole key
    and there is no territory record to point at. }
  TAlternateFormatGroupRec = record
    CountryCode: Integer;
    FormatOffset: Integer;
    FormatCount: Integer;
  end;
  PAlternateFormatGroupRec = ^TAlternateFormatGroupRec;

  { ------------------------------------------------------------------
    Open array views onto the generated tables.

    Every generated table is a typed constant of a FIXED size, so its type
    differs from data set to data set (array[0..253] versus array[0..35] of
    TPhoneMetadataRec). These unbounded views make the tables addressable
    through one pointer type each, which is what lets the lookup layer hold a
    reference to the ACTIVE data set instead of naming one generated unit.

    The upper bound is the usual Pascal "huge array" idiom: the type is never
    instantiated, only pointed at, and the bound has to be large enough that a
    range check over the real table cannot fail.
    ------------------------------------------------------------------ }
  TPhoneMetadataRecArray = array[0..MaxInt div SizeOf(TPhoneMetadataRec) - 1] of TPhoneMetadataRec;
  PPhoneMetadataRecArray = ^TPhoneMetadataRecArray;

  TPhoneNumberDescRecArray = array[0..MaxInt div SizeOf(TPhoneNumberDescRec) - 1] of TPhoneNumberDescRec;
  PPhoneNumberDescRecArray = ^TPhoneNumberDescRecArray;

  TNumberFormatRecArray = array[0..MaxInt div SizeOf(TNumberFormatRec) - 1] of TNumberFormatRec;
  PNumberFormatRecArray = ^TNumberFormatRecArray;

  TCountryCodeGroupRecArray = array[0..MaxInt div SizeOf(TCountryCodeGroupRec) - 1] of TCountryCodeGroupRec;
  PCountryCodeGroupRecArray = ^TCountryCodeGroupRecArray;

  TMetadataSmallIntTable = array[0..MaxInt div SizeOf(SmallInt) - 1] of SmallInt;
  PMetadataSmallIntTable = ^TMetadataSmallIntTable;

  TMetadataIntegerTable = array[0..MaxInt div SizeOf(Integer) - 1] of Integer;
  PMetadataIntegerTable = ^TMetadataIntegerTable;

  TMetadataStringTable = array[0..MaxInt div SizeOf(Pointer) - 1] of string;
  PMetadataStringTable = ^TMetadataStringTable;

  { ------------------------------------------------------------------
    One complete phone metadata data set.

    This is the whole surface LibPhoneNumber.Metadata reads. The lookup
    layer keeps ONE of these as its active source; swapping it swaps every
    table at once, which is the only way the indices stay consistent (a region
    order that belongs to another territory table would silently point at the
    wrong entries).

    Two data sets exist: the production one, built from
    resources/PhoneNumberMetadata.xml, and the upstream TEST one, built from
    resources/PhoneNumberMetadataForTesting.xml, which the ported Java test
    suite runs against. Production is the default and the only one a shipped
    binary links.
    ------------------------------------------------------------------ }
  TPhoneMetadataTables = record
    { Provenance of the data set, straight from the generated unit. }
    GeneratorVersion: string;
    SourceFile: string;
    SourceCommit: string;

    Territories: PPhoneMetadataRecArray;
    TerritoryCount: Integer;

    Descs: PPhoneNumberDescRecArray;
    DescCount: Integer;

    NumberFormats: PNumberFormatRecArray;
    NumberFormatCount: Integer;
    IntlNumberFormats: PNumberFormatRecArray;
    IntlNumberFormatCount: Integer;
    LeadingDigits: PMetadataStringTable;
    LeadingDigitsCount: Integer;

    PossibleLengths: PMetadataSmallIntTable;
    PossibleLengthCount: Integer;

    { Region index: territory indices and region codes, both sorted by ordinal
      region code. }
    RegionOrder: PMetadataSmallIntTable;
    RegionCodes: PMetadataStringTable;
    RegionCount: Integer;

    { Non geographical entities, sorted by country calling code. }
    NonGeoOrder: PMetadataSmallIntTable;
    NonGeoCallingCodes: PMetadataIntegerTable;
    NonGeoCount: Integer;

    { Country calling code groups and the territory indices they address. }
    CountryCodeGroups: PCountryCodeGroupRecArray;
    CountryCodeRegions: PMetadataSmallIntTable;
    CountryCodeCount: Integer;
  end;

const
  { Region id of the non geographical entities. }
  NonGeoRegionCode = '001';

  { Possible length placeholder used by upstream for a number type that does
    not exist in a territory. }
  NoPossibleLength = -1;

implementation

end.
